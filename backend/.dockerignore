.env
.env.*
!.env.example
vendor
tests
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*

# Only present if someone ran a Vite build in the wrong directory; never
# wanted in the image, which serves no assets.
public/build
public/hot
