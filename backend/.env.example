APP_NAME="Tanjay City Public Information Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=Asia/Manila

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=tanjay_portal
DB_USERNAME=tanjay
DB_PASSWORD=local-development-only
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ---------------------------------------------------------------------------
# Cross-origin requests
# ---------------------------------------------------------------------------
# The site is a separate deployment, so every request it makes here is
# cross-origin. Left empty, config/cors.php allows any origin — read the
# comment at the top of that file before deciding that is wrong: this API
# serves nothing but already-published municipal information, with no cookie
# and no credential in it.
#
# Narrow it in production, as a comma-separated list of exact origins
# (scheme and host, no path, no trailing slash):
#
#   CORS_ALLOWED_ORIGINS="https://tanjay.gov.ph,https://www.tanjay.gov.ph"
CORS_ALLOWED_ORIGINS=

# Vercel gives every branch and commit its own preview host, so no fixed list
# can name them. This only takes effect once the list above is narrowed.
#
#   CORS_ALLOWED_ORIGIN_PATTERNS="^https://tanjay-portal-[a-z0-9-]+\.vercel\.app$"
CORS_ALLOWED_ORIGIN_PATTERNS=
