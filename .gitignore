# Repo-root ignores only. The two deploys keep their own, because their build
# artefacts and dependency folders are nothing alike and a single list at the
# root meant every path in it was wrong for one of them:
#
#   backend/.gitignore    vendor, storage keys, the public/storage symlink
#   frontend/.gitignore   node_modules, dist, .vercel
#
# What is left here is the stuff that belongs to a developer's machine rather
# than to either application.

.DS_Store
npm-debug.log
yarn-error.log

# Generated by the cover-art tooling in tools/.
/tools/covers/.fontcache

# Editors and agents. Everyone's are different and none of them are the
# project's, so they are ignored rather than argued about.
/.fleet
/.idea
/.nova
/.vscode
/.zed
/.agents
/.amp
/.claude
/.cursor
/.factory
/.grok
/.junie
/.kiro
/.pi
/.mcp.json
/AGENTS.md
/CLAUDE.md
/boost.json
/opencode.json
/opencode.jsonc
