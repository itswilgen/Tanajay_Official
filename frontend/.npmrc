# Install scripts stay off: a dependency's postinstall is arbitrary code
# running with the developer's permissions, and the build does not need any of
# them — Vite+ ships its native toolchain as prebuilt platform binaries that
# only have to be unpacked. Verified: a clean `pnpm install --frozen-lockfile`
# with this set builds the site.
#
# Inherited from the Laravel app at the repo root, which is where it used to
# live. It is here now because the front end is its own package: the root has
# no package.json any more, so an .npmrc there would reach nothing.
ignore-scripts=true
